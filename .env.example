ALPHA_DATABASE_PATH=./data/alpha.db
ALPHA_STORAGE_PATH=./data/storage
ALPHA_EMAIL_SINK_PATH=./data/emails
# Production: external Postgres takes precedence over ALPHA_DATABASE_PATH.
DATABASE_URL=
# local or s3. Production uses s3-compatible storage (Cloudflare R2 recommended).
ALPHA_STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Disable on a sleeping stateless web service when the scheduled worker is configured.
ALPHA_RUN_EMBEDDED_WORKER=true
ALPHA_BASE_URL=http://127.0.0.1:8000
# fixture, manual, or live. Live requires YOUTUBE_API_KEY.
ALPHA_PROVIDER_MODE=fixture
YOUTUBE_API_KEY=
# OAuth bearer token is required for captions.list/download and only works for tracks the user is authorised to access.
YOUTUBE_OAUTH_ACCESS_TOKEN=
# For durable deployments, prefer refresh credentials; scope must include youtube.force-ssl.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
TIKTOK_RESEARCH_ACCESS_TOKEN=
# Prefer approved Research Tools client credentials for automatic two-hour token renewal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Automatic rights-safe enrichment. Openverse works anonymously; a token increases reliability.
OPENVERSE_API_TOKEN=
# Optional Pexels photo/video search key (commercial-use metadata is retained with every asset).
PEXELS_API_KEY=
ALPHA_ASSET_DISCOVERY_TIMEOUT_SECONDS=15
ALPHA_ASSET_DISCOVERY_MAX_BYTES=50000000
# Optional local/free Whisper-compatible command. {input} and {output_dir} are required placeholders.
# Example: whisper {input} --output_dir {output_dir} --output_format json
ALPHA_TRANSCRIPTION_COMMAND=
ALPHA_TRANSCRIPTION_TIMEOUT_SECONDS=1800
ALPHA_RESEARCH_REGION=GB
ALPHA_RESEARCH_LOOKBACK_DAYS=14
ALPHA_RESEARCH_RESULTS_PER_QUERY=10
ALPHA_WORKER_POLL_SECONDS=1
ALPHA_LEASE_SECONDS=30
ALPHA_RETRY_BASE_SECONDS=1
ALPHA_MAX_JOB_ATTEMPTS=5
ALPHA_REQUIRE_AUTH=false
ALPHA_ADMIN_EMAIL=
ALPHA_ADMIN_PASSWORD=
ALPHA_SESSION_HOURS=12
ALPHA_COOKIE_SECURE=false
# Uses the file sink until a Resend key is present. Set explicitly to file or resend if preferred.
ALPHA_EMAIL_PROVIDER=auto
RESEND_API_KEY=
# Must use a sender at a domain verified in Resend, for example: ALPHA <notifications@example.com>
RESEND_FROM_EMAIL=
ALPHA_EMAIL_TIMEOUT_SECONDS=10
